# Server-only values used by the registration API.
# Copy to .env.local for local development and use real values there.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Keep this only while older parts of the app still use the public Supabase URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Apps Script Web App deployment URL used by registration, scanner,
# and guest-list server routes. Keep this server-side (no NEXT_PUBLIC_ prefix).
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Copy the value between /d/ and /edit from the target Google Sheet URL.
# The registration API rejects a success receipt from any other spreadsheet.
GOOGLE_SPREADSHEET_ID=your-google-spreadsheet-id
